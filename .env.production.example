# GARDA 01 — PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env on the server. Never commit the real .env.

CI_ENVIRONMENT = production

app.baseURL = 'https://your-domain.example/'
app.indexPage = ''
app.defaultLocale = 'id'
app.appTimezone = 'Asia/Jakarta'
app.forceGlobalSecureRequests = true

cookie.prefix = 'garda01_'
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'
session.cookieName = 'garda01_session'

security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.regenerate = true

# Generate with:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
encryption.key = 'hex2bin:1fc73870d9b6bb915ad5a40c40a91384f50f875fc74d6ccf3746b3048d0c657e'

database.default.hostname = localhost
database.default.database = garda01_production
database.default.username = garda01_app
database.default.password = 'REPLACE_WITH_STRONG_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

logger.threshold = 4

deployment.release = '2026.07.1'
deployment.commit = 'REPLACE_WITH_GIT_COMMIT_HASH'
deployment.deployedAt = '2026-07-27T00:00:00+07:00'

AI_PROVIDER = demo
OPENAI_API_KEY =
OPENAI_MODEL = gpt-4o-mini
GITHUB_MODELS_TOKEN =
GITHUB_MODELS_MODEL = openai/gpt-4o-mini
OPENROUTER_API_KEY =
OPENROUTER_MODEL = openrouter/free
